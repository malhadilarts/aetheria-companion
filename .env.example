# Demo works without any secrets using local reflection responses.
# Only enable paid GPT after configuring durable rate limiting.
OPENAI_API_KEY=
AETHERIA_PUBLIC_AI=disabled
OPENAI_MODEL=gpt-4.1-mini
AETHERIA_DAILY_LIMIT=5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# For self-hosted Ollama:
OLLAMA_BASE_URL=http://127.0.0.1:11434
